<Page x:Class="PlatformeGestionThesesEtMemoiresWPF.Windows.UserPages.FavoritePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlatformeGestionThesesEtMemoiresWPF.Windows.UserPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FavoritePage">


    <Grid Background="#FFDCC9A4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#5c5c5c3b" BorderThickness="1" Background="#FFF1E8D6" Margin="10,10,10,10">
            <StackPanel Margin="10">
                <!-- Logo/App Name -->
                <Image x:Name="logo" Height="33" Width="150"  Margin="0,10,0,0" />

                <!-- Navigation Items -->
                <StackPanel>
                    <!-- Home Button -->
                    <Button Content="Home" 
Background="Transparent"
BorderThickness="0" 
Foreground="#333" 
FontSize="14" 
FontWeight="SemiBold"
HorizontalAlignment="Stretch"
Height="40"
Cursor="Hand"

Margin="0,0,0,10" Click="Button_Click_1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{x:Null}">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                        Background="Transparent"
                        CornerRadius="4"
                        Padding="10,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E8F0FE"/>
                                                    <Setter Property="Foreground" Value="#4290f7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- new thes button-->
                    <Button Content="Add These/Memmory" 
Background="Transparent"
BorderThickness="0" 
Foreground="#333" 
FontSize="13" 
FontWeight="SemiBold"
HorizontalAlignment="Stretch"
Height="40"
Cursor="Hand"

