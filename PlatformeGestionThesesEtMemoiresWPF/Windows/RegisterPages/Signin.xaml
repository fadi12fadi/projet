<Page x:Class="PlatformeGestionThesesEtMemoiresWPF.Windows.RegisterPages.Signin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlatformeGestionThesesEtMemoiresWPF.Windows.RegisterPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Signin">

    <Grid Background="#FFDCC9A4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100"/>
            <!-- Sidebar with auto width but minimum 100 -->
            <ColumnDefinition Width="*"/>
            <!-- Content area takes remaining space -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0">
            <Border CornerRadius="4" Height="40" Background="#FF314E3D" Cursor="Hand" Margin="20,40,10,0">
                <Button Content="back" 
                        Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" 
                        FontWeight="SemiBold" Click="Button_Click" Height="40">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{x:Null}">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#4290f7"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3983e4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Background="#FFDCC9A4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Centered content with responsive sizing -->
                <StackPanel Grid.Row="0" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center" 
                             MinWidth="300"
                             MaxWidth="500"
                             Margin="20">
                    <!-- Sign in header -->
                    <TextBlock HorizontalAlignment="Center" 
                               FontSize="32" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,30" Foreground="#FF314E3D">Sign In</TextBlock>

                    <!-- Email field -->
                    <StackPanel Margin="0,0,0,25">
                        <Label FontWeight="SemiBold" FontSize="16" Foreground="#FF314E3D">Username</Label>
                        <Border CornerRadius="4" 
                                BorderBrush="#5c5c5c3b" 
                                BorderThickness="1" 
                                Margin="0,5,0,0" 
                                Height="38"
                                Padding="1">
                            <TextBox x:Name="emailTextBox"
                                    Text="username" 
                                    Padding="10,5" 
                                    Background="White" 
                                    BorderThickness="0"
                                    FontSize="14"
                                    GotFocus="email_GotFocus" 
                                    LostFocus="email_LostFocus"/>
                        </Border>
                    </StackPanel>

                    <!-- Password field -->
                    <StackPanel>
                        <Label FontWeight="SemiBold" FontSize="16" Foreground="#FF314E3D">Password</Label>
                        <Border CornerRadius="4" 
                                BorderBrush="#5c5c5c3b" 
                                BorderThickness="1" 
                                Margin="0,5,0,0" 
                                Height="38"
                                Padding="1">
                            <PasswordBox x:Name="passwordBox"
                                        Password="password" 
                                        Padding="10,5" 
                                        Background="White" 
                                        BorderThickness="0"
                                        FontSize="14"
                                        GotFocus="pwd_GotFocus" 
                                        LostFocus="pwd_LostFocus"/>
                        </Border>
                    </StackPanel>

                    <!-- Sign in button -->
                    <Border CornerRadius="7" Height="40" Background="#FF314E3D" Cursor="Hand" Margin="0,30,0,0">
                        <Button Content="sign in" 
        Background="Transparent" BorderThickness="0" 
        Foreground="White" FontSize="16" FontWeight="SemiBold" Click="Button_Click_1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{x:Null}">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <!-- Ce Border capture les clics -->
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                RecognizesAccessKey="True"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>


                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#4290f7"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3983e4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
