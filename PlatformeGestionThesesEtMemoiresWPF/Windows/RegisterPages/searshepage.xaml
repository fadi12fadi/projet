<Page x:Class="PlatformeGestionThesesEtMemoiresWPF.Windows.RegisterPages.searshepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlatformeGestionThesesEtMemoiresWPF.Windows.RegisterPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="searshepage">

    <Grid Background="#FFDCC9A4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#5c5c5c3b" Margin="0,10,0,0">
            <StackPanel x:Name="stackpanelgauche" Margin="10,-1,10,10" Background="#FFF1E8D6">
                <Image x:Name="logo" Height="33" Width="150"  Margin="0,10,0,0"/>
                <Border CornerRadius="7" Height="32" Background="#FF314E3D" Margin="0,10" Cursor="Hand" Width="{Binding ElementName=stackpanelgauche , Path= Width}">
                    <Button Content="sign in" 
        Click="Button_Click" 
        FontFamily="Times New Roman" FontSize="20" FontWeight="Bold" 
        Foreground="White" Background="{x:Null}" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <!-- On entoure avec un Border pour capter les clics -->
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#4290f7"/>
                            <Style.Triggers>
                                <!-- Hover Effect with Smooth Transition -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#1E232A" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#FF314E3D" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>


                <Border CornerRadius="7" Height="32" Background="#FF314E3D" Margin="0,10" Cursor="Hand">
                    <Button Content="sign up" 
        Background="Transparent" BorderThickness="0" Click="Button_Click_1" 
        Foreground="White" FontSize="20" FontFamily="Times New Roman" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{x:Null}">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <!-- Ajout d'un conteneur pour capter les clics -->
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#4290f7"/>
                            <Style.Triggers>
                                <!-- Hover Effect with Smooth Transition -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#1E232A" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#FF314E3D" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="10 ">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Row -->
            <Border CornerRadius="4" Grid.Row="0"  Margin="0,5" Height="32">
                <TextBox x:Name="Title_searshe" Text="Title" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                          GotFocus="Titre_GotFocus" LostFocus="Titre_LostFocus" FontFamily="Times New Roman" FontWeight="Bold" FontSize="14" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D"/>
            </Border>

            <!-- Author/Subtitle Row -->
            <Grid Grid.Row="1" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Grid.Column="0"  Margin="0,0,5,0" Height="32">
                    <TextBox x:Name="Author_searshe" Text="Author" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                              GotFocus="author_GotFocus" LostFocus="author_LostFocus" FontFamily="Times New Roman" FontSize="14" FontWeight="Bold" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D"/>
                </Border>
                <Border CornerRadius="4" Grid.Column="1" Margin="5,0,0,0">
                    <TextBox x:Name="Keywords_searshe" Text="key words" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                              GotFocus="sous_GotFocus" LostFocus="sous_LostFocus" FontWeight="Bold" FontSize="14" FontFamily="Times New Roman" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D"/>
                </Border>
            </Grid>

            <!-- Domain/University/Faculty Row -->
            <Grid Grid.Row="2" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Grid.Column="0"  Margin="0,0,5,0" Height="32">
                    <TextBox x:Name="Domaine_searshe" Text="Domain" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                              GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D"/>
                </Border>
                <Border CornerRadius="4" Grid.Column="1"  Margin="5,0,5,0">
                    <TextBox x:Name="University_searshe" Text="University" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                              GotFocus="university_GotFocus" LostFocus="university_LostFocus" FontFamily="Times New Roman" FontWeight="Bold" FontSize="14" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D"/>
                </Border>
                <Border CornerRadius="4" Grid.Column="2"  Margin="5,0,0,0">
                    <TextBox x:Name="Faculte_searshe" Text="Faculty" Padding="10 5" Background="#FFF1E8D6" BorderThickness="0"
                              GotFocus="faculte_GotFocus" LostFocus="faculte_LostFocus" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14" CaretBrush="Black" Foreground="#FF314E3D" SelectionBrush="#FF314E3D" />
                </Border>
            </Grid>

            <!-- Date/Search Row -->
            <Grid Grid.Row="3" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Grid.Column="0" BorderBrush="#5c5c5c3b" BorderThickness="1" Margin="0,0,5,0" Height="32">
                    <TextBox x:Name="Date_searshe" Text="YYYY" PreviewTextInput="Date_searshe_PreviewTextInput" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" FontFamily="Times New Roman" Background="#FFF1E8D6" Foreground="#FF314E3D" MaxLength="4" GotFocus="Date_searshe_GotFocus" LostFocus="Date_searshe_LostFocus" />
                </Border>
                <!-- <Border CornerRadius="4" Grid.Column="1" Background="#4290f7" Margin="5,0,0,0">
                    <Button Content="reset" Padding="20 0" Background="Transparent" BorderThickness="0"
                            Click="Button_Click"/>
                </Border>-->
                <Border CornerRadius="4" Grid.Column="1" Height="32" Background="#FF314E3D" Margin="5,0,0,0" Cursor="Hand">
                    <Button Content="reset"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0"
        Click="reset"
        FontSize="18"
        FontFamily="Times New Roman"
        Foreground="White"
        FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="black"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#4290f7"/>
                            <Style.Triggers>
                                <!-- Hover Effect with Smooth Transition -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#1E232A" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#FF314E3D" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!--  <Border CornerRadius="4" Grid.Column="2" Background="#4290f7" Margin="5,0,0,0">
                    <Button Content="search" Padding="20 0" Background="Transparent" BorderThickness="0"
             Click="Button_Click"/>
                </Border>-->
                <Border CornerRadius="4" Grid.Column="2" Height="32" Background="#FF314E3D" Margin="5,0,0,0" Cursor="Hand">
                    <Button Content="search"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0"
        Click="search"
        Foreground="White"
        FontSize="18"
        FontFamily="Times New Roman"
        FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>


                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#4290f7"/>
                            <Style.Triggers>
                                <!-- Hover Effect with Smooth Transition -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#1E232A" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#FF314E3D" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

            </Grid>

            <!-- Results Area -->

        </Grid>
        <ScrollViewer Grid.Column="1" Margin="10,189,10,20" Background="#FFF1E8D6">


            <StackPanel x:Name="stack_panel_these"/>


        </ScrollViewer>
    </Grid>

</Page>
